#!/usr/bin/env bash
# Open Omarchyform, on a particular board if given one.
#
# The launcher entry runs this with no argument, and a file manager runs it
# with the board that was double-clicked, so it has to do both: a bare summon
# and a summon carrying a path.
#
# It exists at all because the desktop entry specification forbids a field code
# like %f inside a quoted argument, and the JSON payload a summon takes has to
# be quoted. Doing it here also means a path containing a quote, a backslash or
# a control character can be escaped properly rather than breaking the payload.
# This installer only ever replaces or removes a file carrying these two keys,
# so a command another program put at this path is left alone.
# X-Omarchyform-Managed=true
# X-Omarchyform-Entry-Version=2
set -euo pipefail

plugin=thepixelgardener.omarchyform

case "${1:-}" in
  -h | --help)
    printf 'usage: %s [board.json]\n' "${0##*/}" >&2
    exit 0
    ;;
esac

if [[ $# -eq 0 || -z ${1:-} ]]; then
  exec omarchy-shell shell summon "$plugin" '{}'
fi

board=$1
[[ -f $board ]] || { printf 'No such board: %s\n' "$board" >&2; exit 1; }
# Absolute, because the shell process has a working directory of its own. The
# x keeps a name that ends in a newline whole: $(...) drops trailing newlines.
board=$(realpath -- "$board" && printf x)
board=${board%$'\n'x}

# JSON string escaping: backslash and quote, then every control character as
# \u00XX. A file name may hold any byte but a slash and NUL, so a newline or a
# tab can arrive here, and JSON allows neither raw inside a string. The
# replacements are quoted so that bash reads nothing in them, & included.
escaped=${board//\\/"\\\\"}
escaped=${escaped//\"/"\\\""}
for code in {1..31}; do
  printf -v character "\\x$(printf %02x "$code")"
  printf -v replacement '\\u%04x' "$code"
  escaped=${escaped//"$character"/"$replacement"}
done

exec omarchy-shell shell summon "$plugin" "{\"action\":\"open\",\"path\":\"$escaped\"}"
