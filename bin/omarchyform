#!/usr/bin/env node
// Boards from the command line, with no window and no display.
//
// The board's logic is already plain JavaScript that runs outside QML — it is
// what the test suite exercises — so making it usable without the shell costs
// a front end and nothing else. Every verb answers with JSON on stdout and
// exits 0 or 1, so something that is not a person can drive it.
//
//   omarchyform new <file> [--note TEXT]... [--force]
//   omarchyform inspect <file> [--full]
//   omarchyform apply <file> [ops.json|-] [--out FILE] [--dry-run]
//   omarchyform validate <file>
//   omarchyform ops
//
// What it deliberately cannot do is draw: a picture of a board needs the
// scene, and the scene needs the shell. `ctrl+e` on an open board exports a
// PNG; nothing here does.
const fs = require("fs")
const os = require("os")
const path = require("path")
const { spawnSync } = require("child_process")
const { loadStore, RowModel } = require("./store")

// Writing goes through the same helper the board itself writes through, so
// there is one coordinated write protocol rather than two that drift: the file
// is replaced under a lock, only if it is still the revision this process
// read, and the version it replaces is kept. That means bash, flock and
// coreutils on the path — the plugin already needs all three.
const HELPER = path.join(__dirname, "..", "BoardFiles.sh")
// The same HOME the plugin reads, so a run under an isolated one — a test, a
// sandbox — keeps its locks and its backups there too.
const LIBRARY = path.join(process.env.HOME || os.homedir(), ".local/share/omarchyform")

function helper(verb, args, input) {
  return spawnSync("bash", [HELPER, verb, ...args], { encoding: "utf8", input: input === undefined ? "" : input })
}

function revisionOf(file) {
  const out = helper("revision", [path.resolve(file)])
  return out.status === 0 ? out.stdout : ""
}

// Where the previous version goes, and where the lock lives.
//
// A board inside the library uses exactly the folders the plugin uses, because
// a lock only serializes anything if both ends pick the same file for the same
// board. Anything else gets a lock in the same place, keyed by its full path:
// locks never sit beside somebody's board, and the boards folder stays free of
// files that are not boards. The previous version, though, is kept beside a
// board that lives outside the library — there is nowhere else it belongs.
function aside(file, kind) {
  const target = path.resolve(file)
  const boards = path.join(LIBRARY, "boards")
  const inLibrary = target.startsWith(boards + path.sep)
  if (kind === "backup")
    return inLibrary ? path.join(LIBRARY, "backups", "v2", target.slice(boards.length + 1) + ".bak")
                     : target + ".bak"
  return path.join(LIBRARY, "locks",
    S.lockKey(inLibrary ? target.slice(boards.length + 1) : target) + ".lock")
}

const S = loadStore()
// The board's history, kept the way the board keeps it: every completed edit,
// so a timeline can play the board back. A run of this is one edit, recorded
// as "Command line"; see docs/splitview-timeline-plan.md.
const H = loadStore(fs.readFileSync(path.join(__dirname, "..", "BoardHistory.js"), "utf8"))
const COMMAND_LINE = "Command line"

function die(message, detail) {
  answer({ ok: false, error: message, detail: detail === undefined ? null : detail })
  process.exit(1)
}

function answer(value) {
  process.stdout.write(JSON.stringify(value, null, 2) + "\n")
}

// ------------------------------------------------------------------ the board
// A board in memory is the two models BoardStore reads and writes, plus the
// next free id: exactly what the plugin holds, minus the camera and what is
// selected.

// The declared format version, straight from the file. readFile does not hand
// it back — it refuses anything it does not know outright — so a board from a
// newer Omarchyform looks the same to it as a corrupt one. They are not the
// same thing and this has to be able to say which.
function declaredVersion(text) {
  try {
    const parsed = JSON.parse(text)
    if (parsed && typeof parsed === "object" && !Array.isArray(parsed))
      return typeof parsed.version === "number" ? parsed.version : 1
  } catch { /* not JSON at all; the caller reports that */ }
  return null
}

function readText(file) {
  try { return fs.readFileSync(file, "utf8") }
  catch (error) { die("cannot read " + file, error.code || String(error)) }
}

// A board's text, loaded the way the plugin loads it: readFile, then the two
// models filled from what it found. Anything that is not a board this
// understands ends the run with the reason.
function loadBoard(file, text) {
  const version = declaredVersion(text)
  // Read whole, history and all: nothing is kept waiting on this, so there is
  // no reason to leave the history as text, and no way for the order of the
  // keys in the file to change what is read.
  const data = S.readFile(text)
  if (!data) {
    // A board from a newer Omarchyform is not a broken one. The board itself
    // opens it read-only rather than saving over what it cannot represent, and
    // saying "not a board" here would invite someone to throw it away.
    if (version !== null && version > S.FORMAT_VERSION)
      die(file + ` is format ${version}, newer than this understands`,
          "the board itself would open it read-only rather than losing anything")
    die(file + " is not a board this understands")
  }
  const items = new RowModel()
  const links = new RowModel()
  S.fillItems(items, data.items)
  S.fillLinks(links, items, data.links)
  return { data, items, links, version, history: data.history }
}

// A board's history, checked before anything is added to it. One that ends
// somewhere else — the file was edited by something that keeps none — gets
// the difference as one record. One that cannot be played is not added to:
// the board itself keeps it aside and starts again, and should be the one to.
function checkHistory(file, history, state) {
  if (history === null || history === undefined) return null
  const shape = H.checkShape(history)
  if (shape !== "")
    die(file + "'s history " + (history && history.v > H.HISTORY_VERSION
      ? "is from a newer Omarchyform" : "cannot be read (" + shape + ")"),
      "open it in Omarchyform, which keeps that history aside and starts a new one")
  const wrong = H.verify(history, state)
  if (wrong === "") return history
  if (H.bridge(history, state, Date.now()) === null)
    die(file + "'s history cannot be read (" + wrong + ")",
        "open it in Omarchyform, which keeps that history aside and starts a new one")
  return history
}

const stateOf = board => ({ items: S.itemRows(board.items), links: S.linkRows(board.links), nextId: board.nextId })

function readBoard(file) {
  // The revision first: what is read is a version of the file, and a write
  // later on has to be able to say which version it was working from.
  const revision = revisionOf(file)
  const { data, items, links, version, history } = loadBoard(file, readText(file))
  const board = { items, links, nextId: S.nextFreeId(items, data.nextId), version, revision }
  board.before = stateOf(board)
  board.history = checkHistory(file, history, board.before)
  return board
}

// The board may be open in the shell, which watches the file and reads it when
// it changes. So it is put there in one step, under the lock, and only onto
// the revision this process read: two writers that both read the same version
// cannot both believe they are updating it. `expected` is "-" when the caller
// has said outright to write over whatever is there.
function writeBoard(board, file, expected) {
  // What this run changed is one record. A board without a history starts
  // one, from the board as it was read; a new board has none until it is
  // first changed.
  let history = board.history || null
  if (board.before) {
    const after = stateOf(board)
    const now = Date.now()
    if (!history && H.diff(board.before, after) !== null) history = H.create(board.before, now, H.newLineage(now))
    if (history) H.append(history, board.before, after, COMMAND_LINE, now)
    if (history) {
      const size = H.measure(history)
      if (size.count > H.MAX_HISTORY_RECORDS || size.bytes > H.MAX_HISTORY_BYTES) H.trim(history)
    }
  }
  board.recorded = history ? history.records.length : 0
  const text = S.writeFile(board.items, board.links, board.nextId, history ? JSON.stringify(history) : "")
  const target = path.resolve(file)
  const written = helper("commit",
    [target, aside(target, "backup"), aside(target, "lock"), expected === undefined ? "-" : expected], text)
  if (written.status === 7)
    die(file + " changed since it was read", "another writer got there first; read it again, or pass --force")
  if (written.status !== 0)
    die("cannot write " + file, (written.stderr || "").trim() || "exit " + written.status)
  return text.length
}

function rowOf(board, id) {
  for (let i = 0; i < board.items.count; i++)
    if (board.items.get(i).iid === Number(id)) return i
  return -1
}

function mustRow(board, id, what) {
  const at = rowOf(board, id)
  if (at < 0) die(`${what}: no item with id ${id}`)
  return at
}

// What a note may say. The board refuses to open one with a longer note, so
// the command line will not write one; it still reads one, which is how such
// a note gets shortened.
function noteText(value, what) {
  const text = value === undefined ? "" : String(value)
  if (text.length > S.MAX_NOTE_LENGTH)
    die(`${what}: the text is ${text.length} characters; a note holds at most ${S.MAX_NOTE_LENGTH}`)
  return text
}

// ------------------------------------------------------------------ the ops
// One table, so `ops` prints what `apply` accepts and the two cannot drift.
// Each entry says what it needs and does it; none of them reaches outside the
// board it was handed.
const OPS = {
  add: {
    args: "kind, x, y, [w], [h], [text], [tint]",
    does: "put a new item on the board; answers with its id",
    run(board, a) {
      const kind = String(a[0] || "note")
      if (S.KINDS.indexOf(kind) < 0) die(`add: ${kind} is not one of ${S.KINDS.join(", ")}`)
      const id = board.nextId++
      board.items.append({
        iid: id, kind: kind,
        ix: S.num(a[1], 0), iy: S.num(a[2], 0),
        iw: Math.max(S.MIN_SIZE, S.num(a[3], 220)), ih: Math.max(S.MIN_SIZE, S.num(a[4], 160)),
        itint: S.normalizeTint(a[6]), itext: noteText(a[5], "add"),
        ipinned: false, isrc: ""
      })
      return { added: id }
    }
  },
  setText: {
    args: "id, text",
    does: "replace what an item says",
    run(board, a) {
      board.items.setProperty(mustRow(board, a[0], "setText"), "itext", noteText(a[1], "setText"))
      return { changed: Number(a[0]) }
    }
  },
  setTint: {
    args: "id, " + S.TINTS.join("|"),
    does: "change which theme role an item is drawn in",
    run(board, a) {
      board.items.setProperty(mustRow(board, a[0], "setTint"), "itint", S.normalizeTint(a[1]))
      return { changed: Number(a[0]) }
    }
  },
  setKind: {
    args: "id, " + S.KINDS.join("|"),
    does: "turn an item into a note, box, ellipse or diamond",
    run(board, a) {
      const kind = String(a[1])
      if (S.KINDS.indexOf(kind) < 0) die(`setKind: ${kind} is not one of ${S.KINDS.join(", ")}`)
      board.items.setProperty(mustRow(board, a[0], "setKind"), "kind", kind)
      return { changed: Number(a[0]) }
    }
  },
  move: {
    args: "id, x, y",
    does: "put an item somewhere else",
    run(board, a) {
      const at = mustRow(board, a[0], "move")
      board.items.setProperty(at, "ix", S.num(a[1], 0))
      board.items.setProperty(at, "iy", S.num(a[2], 0))
      return { changed: Number(a[0]) }
    }
  },
  resize: {
    args: "id, w, h",
    does: "change an item's size, never below the minimum",
    run(board, a) {
      const at = mustRow(board, a[0], "resize")
      board.items.setProperty(at, "iw", Math.max(S.MIN_SIZE, S.num(a[1], S.MIN_SIZE)))
      board.items.setProperty(at, "ih", Math.max(S.MIN_SIZE, S.num(a[2], S.MIN_SIZE)))
      return { changed: Number(a[0]) }
    }
  },
  pin: {
    args: "id, true|false",
    does: "pin an item behind the working canvas, or bring it back",
    run(board, a) {
      board.items.setProperty(mustRow(board, a[0], "pin"), "ipinned", a[1] !== false)
      return { changed: Number(a[0]) }
    }
  },
  remove: {
    args: "id",
    does: "take an item off the board, and every connector touching it",
    run(board, a) {
      const id = Number(a[0])
      const at = mustRow(board, id, "remove")
      board.items.remove(at)
      for (let i = board.links.count - 1; i >= 0; i--) {
        const link = board.links.get(i)
        if (link.lfrom === id || link.lto === id) board.links.remove(i)
      }
      return { removed: id }
    }
  },
  link: {
    args: "from, to",
    does: "join two items, pointing at the second",
    run(board, a) {
      const from = Number(a[0]), to = Number(a[1])
      mustRow(board, from, "link"); mustRow(board, to, "link")
      if (from === to) die("link: an item cannot point at itself")
      for (let i = 0; i < board.links.count; i++) {
        const link = board.links.get(i)
        if (link.lfrom === from && link.lto === to) return { linked: [from, to], already: true }
        // Drawing the same pair the other way round turns it, which is what
        // the board does when you press x on a pair already joined.
        if (link.lfrom === to && link.lto === from) {
          board.links.setProperty(i, "lfrom", from)
          board.links.setProperty(i, "lto", to)
          return { linked: [from, to], turned: true }
        }
      }
      board.links.append({ lfrom: from, lto: to })
      return { linked: [from, to] }
    }
  },
  unlink: {
    args: "from, to",
    does: "remove the connector between two items, whichever way it runs",
    run(board, a) {
      const from = Number(a[0]), to = Number(a[1])
      for (let i = board.links.count - 1; i >= 0; i--) {
        const link = board.links.get(i)
        if ((link.lfrom === from && link.lto === to) || (link.lfrom === to && link.lto === from)) {
          board.links.remove(i)
          return { unlinked: [from, to] }
        }
      }
      return { unlinked: [from, to], already: true }
    }
  }
}

// ------------------------------------------------------------------ the verbs
function verbNew(args) {
  const file = args.shift()
  if (!file) die("new: needs a file to write")
  if (fs.existsSync(file) && !args.includes("--force"))
    die(file + " already exists; pass --force to write over it")
  const board = { items: new RowModel(), links: new RowModel(), nextId: 1 }
  const notes = []
  for (let i = 0; i < args.length; i++) if (args[i] === "--note") notes.push(args[++i])
  // Laid out along a row, far enough apart to read as separate thoughts.
  notes.forEach((text, i) => OPS.add.run(board, ["note", i * 260, 0, 220, 160, text]))
  // Nothing is expected to be there. With --force, whatever is there is what
  // this was told to replace.
  const bytes = writeBoard(board, file, args.includes("--force") ? "-" : "")
  answer({ ok: true, file, items: board.items.count, bytes })
}

function verbInspect(args) {
  const file = args.shift()
  if (!file) die("inspect: needs a board to read")
  const board = readBoard(file)
  const full = args.includes("--full")
  const items = S.itemRows(board.items)
  const out = {
    ok: true, file, version: board.version, nextId: board.nextId,
    items: board.items.count, links: board.links.count,
    bounds: S.bounds(board.items),
    kinds: items.reduce((all, it) => (all[it.kind] = (all[it.kind] || 0) + 1, all), {})
  }
  // The text is the point of a board, so it is always in the answer; the
  // geometry only when asked for, because it is most of the bytes and rarely
  // what the question was.
  out.contents = items.map(it => full ? it : { id: it.id, kind: it.kind, text: it.text })
  if (full) out.connectors = S.linkRows(board.links)
  answer(out)
}

function verbValidate(args) {
  const file = args.shift()
  if (!file) die("validate: needs a board to read")
  const { data, items, links, version, history } = loadBoard(file, readText(file))
  // What loading had to repair. A board is hand-editable and shareable, so
  // this is the difference between what is on disk and what would be drawn.
  const repairs = []
  const rawItems = Array.isArray(data.items) ? data.items.length : 0
  if (rawItems !== items.count) repairs.push(`${rawItems - items.count} item(s) could not be used`)
  const rawLinks = Array.isArray(data.links) ? data.links.length : 0
  if (rawLinks !== links.count) repairs.push(`${rawLinks - links.count} connector(s) pointed at nothing`)
  // Not a repair: nothing is changed. The board opens it read-only and empty.
  const warnings = []
  const overlong = S.overlongNote(data.items)
  if (overlong >= 0) {
    const row = data.items[overlong]
    warnings.push(`${row.id === undefined ? "a note" : "item " + row.id} is longer than ${S.MAX_NOTE_LENGTH} characters; `
      + "the board opens read-only until it is shorter")
  }
  // The history is checked, not changed: how many edits it holds, and whether
  // it plays back to this board.
  let kept = null
  if (history !== null && history !== undefined) {
    const shape = H.checkShape(history)
    const state = { items: S.itemRows(items), links: S.linkRows(links), nextId: S.nextFreeId(items, data.nextId) }
    const problem = shape !== "" ? shape : H.verify(history, state)
    kept = { records: Array.isArray(history.records) ? history.records.length : 0, plays: problem === "" }
    if (problem !== "") warnings.push("its history " + problem)
  }
  answer({ ok: true, file, version, items: items.count, links: links.count, history: kept, repairs, warnings })
}

function verbApply(args) {
  const file = args.shift()
  if (!file) die("apply: needs a board to change")
  const source = args[0] && !args[0].startsWith("--") ? args.shift() : "-"
  let raw
  try { raw = source === "-" ? fs.readFileSync(0, "utf8") : fs.readFileSync(source, "utf8") }
  catch (error) { die("cannot read operations from " + source, error.code || String(error)) }
  let ops
  try { ops = JSON.parse(raw) }
  catch (error) { die("the operations are not JSON") }
  if (!Array.isArray(ops)) die("the operations must be a list")

  const board = readBoard(file)
  const results = []
  ops.forEach((entry, i) => {
    if (!entry || typeof entry.op !== "string") die(`operation ${i} has no op`)
    // Its own entries only: OPS is a plain object, so "toString" or
    // "constructor" would otherwise find something that is not an operation.
    const op = Object.prototype.hasOwnProperty.call(OPS, entry.op) ? OPS[entry.op] : null
    if (!op) die(`operation ${i}: there is no ${entry.op}`, Object.keys(OPS))
    results.push(Object.assign({ op: entry.op }, op.run(board, entry.args || [])))
  })

  const out = args.includes("--out") ? args[args.indexOf("--out") + 1] : file
  if (args.includes("--dry-run")) {
    answer({ ok: true, file, dryRun: true, applied: results, items: board.items.count, links: board.links.count })
    return
  }
  // Writing back to the board it came from expects that board to still be the
  // version it was read from. Writing somewhere else is a new file's business.
  const expected = path.resolve(out) === path.resolve(file) && !args.includes("--force")
    ? board.revision : "-"
  const bytes = writeBoard(board, out, expected)
  answer({ ok: true, file: out, applied: results, items: board.items.count, links: board.links.count, bytes,
           history: board.recorded })
}

function verbOps() {
  answer({
    ok: true,
    ops: Object.keys(OPS).map(name => ({ op: name, args: OPS[name].args, does: OPS[name].does })),
    kinds: S.KINDS, tints: S.TINTS, minimumSize: S.MIN_SIZE
  })
}

const VERBS = { new: verbNew, inspect: verbInspect, apply: verbApply, validate: verbValidate, ops: verbOps }

const argv = process.argv.slice(2)
const verb = argv.shift()
if (!verb || verb === "-h" || verb === "--help") {
  answer({ ok: true, usage: Object.keys(VERBS), hint: "omarchyform ops lists what apply accepts" })
  process.exit(verb ? 0 : 1)
}
if (!VERBS[verb]) die(`there is no ${verb}`, Object.keys(VERBS))
VERBS[verb](argv)
