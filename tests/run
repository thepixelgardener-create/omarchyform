#!/usr/bin/env bash
# One command for a reviewer who does not know this stack: everything that can
# run anywhere, then the desktop suites when their runners are installed.
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd -- "$root"

# Node only: no dependencies, no compositor, no Qt.
npm test

# The scripts are run by the plugin, so a syntax error in one is a defect the
# JavaScript suites cannot see.
bash -n BoardFiles.sh desktop/install.sh tests/run

# Shadowing a final property of Item stops a whole file loading under the
# shell's Qt, and no unit test sees it: the JavaScript suites never load QML,
# and the Qt suite loads Node.qml rather than the surfaces. qmllint does see it,
# without needing the shell's own modules to resolve.
if [[ -x /usr/lib/qt6/bin/qmllint ]]; then
  overrides=$(/usr/lib/qt6/bin/qmllint ./*.qml 2>&1 | grep -F 'property-override' || true)
  if [[ -n $overrides ]]; then
    printf '%s\n' "$overrides" >&2
    printf 'A member here shadows a final one; the shell will refuse the file.\n' >&2
    exit 1
  fi
else
  printf 'skipped: final-property check needs qmllint\n'
fi

# Qt and Quickshell are present on an Omarchy machine and absent in a plain
# container. Say which was skipped rather than passing quietly.
runner=${QMLTESTRUNNER:-/usr/lib/qt6/bin/qmltestrunner}
if [[ -x $runner ]]; then npm run test:ui
else printf 'skipped: pointer and theme tests need %s\n' "$runner"
fi

if command -v qs >/dev/null 2>&1; then npm run test:qml
else printf 'skipped: persistence tests need quickshell (qs)\n'
fi

printf 'All available checks passed.\n'
