#!/usr/bin/env bash
# One command for a reviewer who does not know this stack: everything that can
# run anywhere, then the desktop suites when their runners are installed.
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd -- "$root"

# Node only: no dependencies, no compositor, no Qt.
npm test

# The security and privacy screen CI runs beside the unit tests. The
# marketplace baseline it also runs fetches the marketplace's checker, so it is
# left to CI (npm run review:marketplace).
node tests/security.js

# The scripts are run by the plugin, so a defect in one is a defect the
# JavaScript suites cannot see: shellcheck where it is installed, bash -n
# where it is not, and the Python helper parsed.
npm run lint

# No QML file gains a qmllint warning against where this branch left main,
# and none shadows a final property of Item: that stops a whole file loading
# under the shell's Qt, and no unit test sees it.
if [[ -x ${QMLLINT:-/usr/lib/qt6/bin/qmllint} ]]; then npm run lint:qml
elif [[ -n ${OMARCHYFORM_STRICT:-} ]]; then printf 'qmllint is required here\n' >&2; exit 1
else printf 'skipped: qmllint checks need /usr/lib/qt6/bin/qmllint\n'
fi

# Qt and Quickshell are present on an Omarchy machine and absent in a plain
# container. Say which was skipped rather than passing quietly.
runner=${QMLTESTRUNNER:-/usr/lib/qt6/bin/qmltestrunner}
if [[ -x $runner ]]; then npm run test:ui
elif [[ -n ${OMARCHYFORM_STRICT:-} ]]; then printf '%s is required here\n' "$runner" >&2; exit 1
else printf 'skipped: pointer and theme tests need %s\n' "$runner"
fi

if command -v qs >/dev/null 2>&1; then npm run test:qml
elif [[ -n ${OMARCHYFORM_STRICT:-} ]]; then printf 'quickshell (qs) is required here\n' >&2; exit 1
else printf 'skipped: persistence tests need quickshell (qs)\n'
fi

printf 'All available checks passed.\n'
